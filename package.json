{
  "name": "myturn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test tests/observability/*.test.ts tests/surveys/*.test.ts",
    "admin:hash-password": "node scripts/hash-admin-password.mjs",
    "check:observability": "node scripts/check-observability.mjs",
    "restore:email-user": "node scripts/restore-email-user.js",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:verify": "prisma migrate diff --exit-code --from-config-datasource --to-schema prisma/schema.prisma",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1074.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@getbrevo/brevo": "^6.0.2",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.1.0",
    "google-auth-library": "^10.9.0",
    "lucide-react": "^1.28.0",
    "next": "^16.2.6",
    "node-cron": "^4.2.1",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "postcss": "^8.5.25",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@prisma/config": "7.8.0",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "7.8.0",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "@prisma/engines@7.8.0": true,
    "prisma@7.8.0": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.4": true,
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true,
    "@firebase/util@1.15.1": true
  }
