# Runtime connection URL. Use the provider's pooled URL when required.
DATABASE_URL="postgresql://postgres:REPLACE_ME@127.0.0.1:5432/myturn"
# Direct connection used by operational tooling when the provider requires a
# separate non-pooled endpoint.
DIRECT_URL="postgresql://postgres:REPLACE_ME@127.0.0.1:5432/myturn"

REVENUECAT_SECRET_KEY=""

# Structured backend logging. Production logs are emitted as one JSON object
# per line to stdout and should be collected by the hosting platform.
LOG_LEVEL="info"
LOG_SERVICE="myturn-api"
LOG_ENVIRONMENT="development"
# Set this to the deployed Git SHA or immutable release identifier.
LOG_RELEASE="local"

# Persist only warning/error/fatal incidents to PostgreSQL. API error writes
# fail open to Vercel stdout if the database is unavailable.
INCIDENT_PERSISTENCE_ENABLED="true"
INCIDENT_PERSIST_TIMEOUT_MS="750"
INCIDENT_WARNING_RETENTION_DAYS="30"
INCIDENT_ERROR_RETENTION_DAYS="90"

# Vercel sends this as Authorization: Bearer <CRON_SECRET> for configured
# vercel.json scheduled routes such as /api/cron/incidents.
CRON_SECRET="REPLACE_ME"

# Protects POST /api/cron, which manually runs every application cron check.
# Set CRON_MODE=manual on non-Vercel serverless platforms. Vercel is detected
# automatically and will not start the in-process node-cron scheduler.
CRON_API_KEY="REPLACE_ME"
CRON_MODE="manual"

# Cloudflare R2 Credentials (for Server-Side upload/download/transcoding)
CLOUDFLARE_R2_ACCOUNT_ID="REPLACE_ME"
CLOUDFLARE_R2_ACCESS_KEY_ID="REPLACE_ME"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="REPLACE_ME"

# OPTIONAL: Define this if you want to use the Cloudflare Free Tier single bucket limit.
# If configured, R2 partitions logical buckets (vlogs, avatars) as folder prefixes inside this single bucket.
# If left empty, the code expects separate R2 buckets named "vlogs", "avatars", and "feedback".
CLOUDFLARE_R2_BUCKET_NAME="your-r2-bucket"
NEXT_PUBLIC_MEDIA_URL="https://media.example.com"

# Comma-separated SHA-256 fingerprints for production Android signing
# certificates. Used by /.well-known/assetlinks.json for verified app links.
ANDROID_APP_CERT_SHA256="AA:BB:CC:..."

NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=***
NEXT_PUBLIC_POSTHOG_HOST=**

# Firebase Admin SDK Credentials (Private)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="REPLACE_ME"

# Firebase App Check uses the Admin credentials above to verify the
# X-Firebase-AppCheck header on every user-facing /api route.


B2_ENDPOINT="https://s3.your-region.backblazeb2.com"
B2_REGION="your-region"
B2_BUCKET_NAME="your-b2-bucket"
B2_ACCESS_KEY_ID="REPLACE_ME"
B2_SECRET_ACCESS_KEY="REPLACE_ME"

# Cryptographic Shared Secret for Token & Cookie Signatures
# (Must match the MEDIA_SECRET_KEY env variable in your Cloudflare Worker!)
MEDIA_SECRET_KEY="REPLACE_ME"
REVENUECAT_BOOST_PRODUCT_IDS="com.myturn.boost,com.myturn.pro_boost"
# Development only; sandbox transactions are always rejected in production.
REVENUECAT_ALLOW_SANDBOX_PURCHASES="false"
TRANSCODER_WEBHOOK_SECRET="REPLACE_ME"


APP_BASE_URL="http://localhost:3000"
AUTH_STATE_SECRET="REPLACE_ME"
# Dedicated HMAC pepper for email verification, password reset, and account
# deletion codes. Use at least 32 random bytes and rotate only with a plan to
# invalidate all outstanding codes.
AUTH_CODE_SECRET="REPLACE_ME"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="REPLACE_ME"
# Add `${APP_BASE_URL}/api/auth/mobile/google/callback` as an authorized
# redirect URI on this Google OAuth web client.

NEXT_PUBLIC_ALLOW_REGISTRATION="true"
NEXT_PUBLIC_ALLOW_SOCIAL_LOGIN="true"

# Individual social provider toggles ("true" or "false")
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN="true"
NEXT_PUBLIC_ENABLE_APPLE_LOGIN="false"
NEXT_PUBLIC_ENABLE_FACEBOOK_LOGIN="false"

# Brevo transactional SMTP/API delivery
BREVO_API_KEY="REPLACE_ME"
BREVO_SENDER_EMAIL="noreply@example.com"
BREVO_SENDER_NAME="MyTurn"
