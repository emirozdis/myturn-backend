# MyTurn backend environment
#
# Copy this file to `.env` for local development or configure the same keys in
# the production hosting platform. Never commit real credentials.
#
# Generate independent secrets with:
#   openssl rand -base64 48
#
# Do not reuse AUTH_STATE_SECRET, AUTH_CODE_SECRET, MEDIA_SECRET_KEY,
# CRON_SECRET, CRON_API_KEY, TRANSCODER_API_KEY, or
# TRANSCODER_WEBHOOK_SECRET.

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------

# Canonical public origin of this backend. No trailing slash.
# Production example: https://api.example.com
APP_BASE_URL="http://localhost:3000"

# Public callback origin sent to the transcoder. Normally identical to
# APP_BASE_URL. Retained as a separate setting only when callbacks use a
# different public origin.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public media/CDN worker origin. No trailing slash.
NEXT_PUBLIC_MEDIA_URL="https://media.example.com"

# -----------------------------------------------------------------------------
# PostgreSQL / Prisma
# -----------------------------------------------------------------------------

# Runtime connection. In Supabase production, use the transaction-mode pooled
# URL (normally port 6543) and keep `pgbouncer=true` if required by the provider.
DATABASE_URL="postgresql://postgres:REPLACE_ME@127.0.0.1:5432/myturn"

# Direct/session-mode connection used only by Prisma migrations and operational
# tooling. Never run migrations through a transaction-mode pooler.
DIRECT_URL="postgresql://postgres:REPLACE_ME@127.0.0.1:5432/myturn"

# -----------------------------------------------------------------------------
# Firebase Authentication and App Check
# -----------------------------------------------------------------------------

# Firebase Admin service-account credentials. FIREBASE_PRIVATE_KEY must keep
# literal `\n` sequences when stored as a single-line hosting-platform value.
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="REPLACE_ME"

# App Check verification and limited-use token consumption use the same Firebase
# Admin credentials. There is no separate server-side App Check secret.

# Dedicated HMAC key for OAuth state. Required, minimum 32 characters.
AUTH_STATE_SECRET="REPLACE_ME"

# Dedicated HMAC pepper for verification, password-reset, and account-deletion
# codes. Required, minimum 32 characters. Rotating it invalidates outstanding
# codes.
AUTH_CODE_SECRET="REPLACE_ME"

# -----------------------------------------------------------------------------
# Google mobile OAuth
# -----------------------------------------------------------------------------

# Use a Google OAuth Web application client. Register this exact redirect URI:
#   ${APP_BASE_URL}/api/auth/mobile/google/callback
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="REPLACE_ME"

# Registration and Google-login kill switches. Omit or set to "true" to enable.
NEXT_PUBLIC_ALLOW_REGISTRATION="true"
NEXT_PUBLIC_ALLOW_SOCIAL_LOGIN="true"
NEXT_PUBLIC_ENABLE_GOOGLE_LOGIN="true"

# -----------------------------------------------------------------------------
# Transactional email (Brevo)
# -----------------------------------------------------------------------------

# Required for verification, password-reset, and account-deletion codes.
BREVO_API_KEY="REPLACE_ME"
BREVO_SENDER_EMAIL="noreply@example.com"
BREVO_SENDER_NAME="MyTurn"

# -----------------------------------------------------------------------------
# Cloudflare R2 hot media storage
# -----------------------------------------------------------------------------

CLOUDFLARE_R2_ACCOUNT_ID="REPLACE_ME"
CLOUDFLARE_R2_ACCESS_KEY_ID="REPLACE_ME"
CLOUDFLARE_R2_SECRET_ACCESS_KEY="REPLACE_ME"

# Optional single-bucket mode. When set, logical `vlogs`, `avatars`, and
# `feedback` buckets are stored as prefixes inside this physical bucket.
# Leave empty only when three separate physical buckets exist.
CLOUDFLARE_R2_BUCKET_NAME="your-r2-bucket"

# Shared with the Cloudflare media Worker. Required, minimum 32 characters.
# Configure the identical value as a Worker secret.
MEDIA_SECRET_KEY="REPLACE_ME"

# -----------------------------------------------------------------------------
# Backblaze B2 cold archive
# -----------------------------------------------------------------------------

# Required only when cold-archive operations are enabled.
B2_ENDPOINT="https://s3.your-region.backblazeb2.com"
B2_REGION="your-region"
B2_BUCKET_NAME="your-b2-bucket"
B2_ACCESS_KEY_ID="REPLACE_ME"
B2_SECRET_ACCESS_KEY="REPLACE_ME"

# -----------------------------------------------------------------------------
# Transcoder service
# -----------------------------------------------------------------------------

# May be either the service origin or the full endpoint. When only an origin is
# supplied, `/api/v1/videos/process-remote` is appended automatically.
TRANSCODER_API_URL="https://transcoder.example.com"

# Must match the transcoder service's inbound API key.
TRANSCODER_API_KEY="REPLACE_ME"

# Must match the secret used by the transcoder to sign callbacks to
# `${NEXT_PUBLIC_APP_URL}/api/webhooks/transcoder`.
TRANSCODER_WEBHOOK_SECRET="REPLACE_ME"

# -----------------------------------------------------------------------------
# RevenueCat
# -----------------------------------------------------------------------------

# RevenueCat secret server API key. Never use a public mobile SDK key here.
REVENUECAT_SECRET_KEY="REPLACE_ME"

# Comma-separated allowlist of non-subscription product identifiers that grant
# boost credits.
REVENUECAT_BOOST_PRODUCT_IDS="com.myturn.boost,com.myturn.pro_boost"

# Development only. Sandbox purchases are always rejected when NODE_ENV is
# production.
REVENUECAT_ALLOW_SANDBOX_PURCHASES="false"

# -----------------------------------------------------------------------------
# Scheduled jobs
# -----------------------------------------------------------------------------

# Vercel supplies this value as `Authorization: Bearer <CRON_SECRET>` to routes
# declared in vercel.json, including GET /api/cron/incidents.
CRON_SECRET="REPLACE_ME"

# Protects the manual POST /api/cron endpoint through the `x-api-key` header.
CRON_API_KEY="REPLACE_ME"

# Use "manual" on Vercel/serverless. Use "internal" only on a persistent Node
# process where in-process node-cron jobs should run.
CRON_MODE="manual"

# -----------------------------------------------------------------------------
# Structured logging and durable incident records
# -----------------------------------------------------------------------------

# Valid levels: trace, debug, info, warn, error, fatal, silent.
LOG_LEVEL="info"
LOG_SERVICE="myturn-api"
LOG_ENVIRONMENT="development"

# Immutable Git SHA or release identifier. Vercel falls back to
# VERCEL_GIT_COMMIT_SHA when this is omitted.
LOG_RELEASE="local"

# Set to "false" to disable PostgreSQL incident persistence while retaining
# structured stdout/stderr logging.
INCIDENT_PERSISTENCE_ENABLED="true"
INCIDENT_PERSIST_TIMEOUT_MS="750"
INCIDENT_WARNING_RETENTION_DAYS="30"
INCIDENT_ERROR_RETENTION_DAYS="90"

# -----------------------------------------------------------------------------
# Dedicated administrator access
# -----------------------------------------------------------------------------

# These credentials are intentionally independent from Firebase app users.
# Use a unique email address and never reuse an app-user password. A single-use
# code is sent to this address after every successful password check, so the
# Brevo transactional email values above are also required for admin access.
ADMIN_EMAIL="admin@example.com"

# Generate this value with: npm run admin:hash-password
ADMIN_PASSWORD_HASH="REPLACE_ME"

# Dedicated signing key for the eight-hour, HTTP-only admin session cookie.
# Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET="REPLACE_ME"

# -----------------------------------------------------------------------------
# Cloudflare media Worker (configured in Wrangler, not the Next.js host)
# -----------------------------------------------------------------------------

# The Worker separately requires MEDIA_SECRET_KEY and the B2 values above.
# Configure its R2 binding as `MY_BUCKET` in Cloudflare/Wrangler; bindings are
# not ordinary environment strings.
ALLOWED_ORIGIN="https://app.example.com"

# -----------------------------------------------------------------------------
# Platform-managed variables — do not normally define these yourself
# -----------------------------------------------------------------------------
#
# NODE_ENV
# NEXT_PHASE
# NEXT_RUNTIME
# VERCEL
# VERCEL_GIT_COMMIT_SHA
